{
  "name": "weniv-world-desktop",
  "private": true,
  "version": "1.0.1",
  "productName": "Weniv World",
  "description": "위니브월드 설치판 — 인터넷 없이 파이썬으로 캐릭터를 움직이며 스토리를 푸는 학습 앱",
  "author": "WENIV",
  "license": "Apache-2.0",
  "main": "main.cjs",
  "scripts": {
    "prepare-app": "node scripts/prepare.mjs",
    "start": "npm run prepare-app && electron .",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dist": "npm run prepare-app && electron-builder",
    "dist:win": "npm run prepare-app && electron-builder --win",
    "dist:mac": "npm run prepare-app && electron-builder --mac",
    "release": "node scripts/publish-release.mjs"
  },
  "devDependencies": {
    "@fontsource/source-code-pro": "5.3.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.0",
    "pretendard": "1.3.9",
    "pyodide": "314.0.7"
  }
}
