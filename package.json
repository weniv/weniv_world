{
    "name": "weniv-world",
    "private": true,
    "scripts": {
        "start": "webpack serve --open --mode=development",
        "build": "webpack --mode=production",
        "webpack": "webpack --mode=production",
        "scss": "sass --watch --no-source-map assets/css/style.scss assets/css/style.css",
        "scss:build": "sass --no-source-map assets/css/style.scss assets/css/style.css",
        "build:vendor": "esbuild scripts/codemirror-entry.js --bundle --format=esm --minify --legal-comments=eof --outfile=assets/vendor/codemirror.js",
        "test": "python -m unittest discover tests && npm run test:js",
        "test:js": "node --experimental-default-type=module --test tests/*.test.mjs"
    },
    "devDependencies": {
        "@codemirror/autocomplete": "^6.18.6",
        "@codemirror/commands": "^6.8.1",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/language": "^6.11.0",
        "@codemirror/state": "^6.5.2",
        "@codemirror/view": "^6.36.8",
        "@lezer/highlight": "^1.2.1",
        "codemirror": "^6.0.2",
        "copy-webpack-plugin": "^14.0.0",
        "esbuild": "^0.28.2",
        "html-webpack-plugin": "^5.6.3",
        "sass": "^1.89.0",
        "webpack": "^5.99.9",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^6.0.0"
    }
}
